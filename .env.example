# Copie este arquivo para ".env" e preencha as chaves que quiser usar.
# Todas são opcionais: sem elas, o dashboard funciona normalmente.

# Chave do Google Gemini. Sem ela, o relatório executivo é gerado pelo
# motor estatístico local (scikit-learn).
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Modelo do Gemini (opcional). Padrão: gemini-flash-latest
GEMINI_MODEL=

# Modelo reserva (opcional), usado se o principal estiver sobrecarregado,
# sem cota ou indisponível. Padrão: gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=

# Limites de uso da GEMINI_API_KEY acima (opcional), para que visitantes do app
# publicado não esgotem a sua cota. Quem digita a própria chave no app não tem limite.
# Padrão: 20 chamadas por hora por sessão e 300 por dia no servidor todo.
SERVER_KEY_CALLS_PER_HOUR=
SERVER_KEY_CALLS_PER_DAY=

# Chave Demo gratuita da CoinGecko (opcional). Aumenta o limite de
# requisições. Obtenha em: https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# Nível de detalhe dos logs no terminal (opcional): DEBUG, INFO, WARNING
# ou ERROR. Padrão: INFO
LOG_LEVEL=
