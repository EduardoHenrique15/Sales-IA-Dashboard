# Copie este arquivo para ".env" e preencha as chaves que quiser usar.
# Todas são opcionais: sem elas, o dashboard funciona normalmente.

# Chave do Google Gemini. Sem ela, o relatório executivo é gerado pelo
# motor estatístico local (scikit-learn).
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Modelo do Gemini (opcional). Padrão: gemini-flash-latest
GEMINI_MODEL=

# Chave Demo gratuita da CoinGecko (opcional). Aumenta o limite de
# requisições. Obtenha em: https://www.coingecko.com/en/api
COINGECKO_API_KEY=
