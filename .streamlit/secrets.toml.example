# Exemplo de segredos para o Streamlit (local ou Streamlit Community Cloud).
# Localmente: copie para ".streamlit/secrets.toml" (já ignorado pelo git).
# No Streamlit Community Cloud: cole este conteúdo em App settings > Secrets.
# Todas as chaves são opcionais.

GEMINI_API_KEY = ""
# Com a cota gratuita, o modelo lite como principal esgota menos a cota (e foi o mais bem avaliado em evals/)
GEMINI_MODEL = "gemini-flash-lite-latest"
GEMINI_FALLBACK_MODEL = "gemini-flash-latest"
# limites de uso da chave acima para visitantes (por sessão/hora e no servidor/dia)
SERVER_KEY_CALLS_PER_HOUR = 20
SERVER_KEY_CALLS_PER_DAY = 300
